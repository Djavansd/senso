rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function userIdentityKeys() {
      return ["uid", "email", "nome", "updatedAt"];
    }

    function userCreateKeys() {
      return ["uid", "email", "nome", "updatedAt", "autorizado", "plano", "status", "tipoPagamento", "validade"];
    }

    function userAccessAllowed(uid) {
      return isOwner(uid)
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.autorizado != false
        && paymentAccessAllowed(uid);
    }

    function normalizeUserPlan(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isBasicMonthly(uid) {
      let user = normalizeUserPlan(uid);
      return user.plano == "basico"
        && user.tipoPagamento != "avista"
        && user.tipoPagamento != "a vista"
        && user.tipoPagamento != "à vista";
    }

    function isFreePlan(uid) {
      let user = normalizeUserPlan(uid);
      return user.plano == "gratis" || !user.keys().hasAny(["plano"]);
    }

    function isMonthlyAppPlan(user) {
      return (user.plano == "pro" || user.plano == "basico")
        && user.tipoPagamento != "avista"
        && user.tipoPagamento != "a vista"
        && user.tipoPagamento != "à vista"
        && user.tipoPagamento != "Ã  vista";
    }

    function paymentAccessAllowed(uid) {
      let user = normalizeUserPlan(uid);
      return user.status != "bloqueado"
        && (
          !isMonthlyAppPlan(user)
          || (
            user.keys().hasAny(["validade"])
            && user.validade is timestamp
            && request.time <= user.validade + duration.value(5, "d")
          )
        );
    }

    function hasAppDataPayload() {
      return request.resource.data.keys().hasAll(["data"]);
    }

    function clientesCount() {
      return hasAppDataPayload()
        && request.resource.data.data.keys().hasAll(["clientes"])
        ? request.resource.data.data.clientes.size()
        : 0;
    }

    function servicosCount() {
      return hasAppDataPayload()
        && request.resource.data.data.keys().hasAll(["servicos"])
        ? request.resource.data.data.servicos.size()
        : 0;
    }

    function appDataWithinPlan(uid) {
      return isFreePlan(uid)
        ? (clientesCount() <= 5 && servicosCount() <= 10)
        : (
            !isBasicMonthly(uid)
            || (clientesCount() <= 50 && servicosCount() <= 150)
          );
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(userCreateKeys())
        && request.resource.data.autorizado == false
        && request.resource.data.plano == "gratis"
        && request.resource.data.status == "ativo"
        && request.resource.data.tipoPagamento == "mensal"
        && request.resource.data.validade == null;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userIdentityKeys());
      allow delete: if false;

      match /appData/{profileId} {
        allow read: if userAccessAllowed(uid);
        allow write: if userAccessAllowed(uid) && appDataWithinPlan(uid);
      }

      match /appSettings/{profileId} {
        allow read, write: if userAccessAllowed(uid);
      }

      match /{document=**} {
        allow read: if userAccessAllowed(uid);
        allow write: if false;
      }
    }

    match /billingAlerts/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /appConfig/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
